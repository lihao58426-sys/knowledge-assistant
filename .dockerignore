# ── Python 编译产物（运行时生成，白占空间）──
__pycache__/
*.pyc
*.pyo

# ── 版本控制（git 历史不进镜像）──
.git/
.gitignore
.gitattributes

# ── 运行时数据（通过 volume 挂载，不进镜像、否则容器删了数据就丢了）──
chroma_db/
*.db
*.log

# ── 开发工具 ──
.vscode/
.idea/

# ── 临时文件 ──
server_run.log

# ⚠️ 注意：.model-cache/ 不在忽略列表中
# Dockerfile 需要从这里 COPY 预下载的模型文件，必须进入构建上下文
