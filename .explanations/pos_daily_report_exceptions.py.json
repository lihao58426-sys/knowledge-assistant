    {
      "start": 1,
      "end": 16,
      "text": "模块文档说明自定义异常类的设计动机：区分不同失败场景（网络、密码、数据格式），避免裸 except Exception 导致处理混乱。"
    },
    {
      "start": 19,
      "end": 25,
      "text": "AuthError 用于认证失败（密码错误、账号锁定等），不应重试，需人工介入。"
    },
    {
      "start": 28,
      "end": 34,
      "text": "ParseError 用于数据解析失败（页面结构变化），应记录原始 HTML 并告警开发者。"
    },
    {
      "start": 37,
      "end": 43,
      "text": "PushError 用于消息推送失败（网络不通），可重试或切换备用渠道。"
    },
    {
      "start": 46,
      "end": 52,
      "text": "ConfigError 用于配置错误（文件缺失、环境变量未设置），应立刻终止并提示用户检查。"
    }
  ]
}